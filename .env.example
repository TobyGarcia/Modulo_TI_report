# ==========================================
# CONFIGURACIÓN PARA DESPLIEGUE EN RENDER Y SUPABASE
# ==========================================

# URL de Conexión a Base de Datos Supabase (Recomendado Pooler puerto 6543 o 5432)
# Ejemplo: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Habilitar/Forzar SSL (true por defecto para Supabase y en producción)
DB_SSL=true

# ==========================================
# CONFIGURACIÓN GENERAL DEL BACKEND
# ==========================================
PORT=3000
NODE_ENV=production
JWT_SECRET=genera_un_valor_aleatorio_seguro_de_al_menos_48_caracteres
CORS_ORIGINS=*

# Credenciales para la creación inicial automática del primer usuario administrador
BOOTSTRAP_ADMIN_USERNAME=admin_inicial
BOOTSTRAP_ADMIN_PASSWORD=usa_una_contrasena_inicial_de_12_o_mas_caracteres

# ==========================================
# CONFIGURACIÓN PARA DESARROLLO LOCAL (DOCKER COMPOSE)
# ==========================================
# PostgreSQL Local (si no se usa DATABASE_URL)
POSTGRES_USER=inventario_app
POSTGRES_PASSWORD=usa_una_contrasena_larga_y_unica
POSTGRES_DB=inventario_qr
POSTGRES_PORT=5432

DB_HOST=postgres
DB_USER=inventario_app
DB_PASSWORD=usa_una_contrasena_larga_y_unica
DB_NAME=inventario_qr
DB_PORT=5432

# Frontend Local
VITE_API_URL=http://localhost:3000/api
VITE_NGROK_DOMAIN=
